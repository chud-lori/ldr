MONGO_URI=mongodb://localhost:27017
PORT=8080
MONGO_DB=test

# HMAC secret for signing session tokens (X-User-ID values).
# Required in prod — without it the server generates an ephemeral key on
# boot and every restart silently invalidates all sessions. Generate with
#   openssl rand -base64 48
# Rotating this value force-signs out every active user — use for global
# revocation if a token leaks.
SESSION_SECRET=

# On-disk root for Film Roll uploads (photos + short video).
# Dev: leave at default to write under ./media in your working dir.
# Prod: set to a system-managed path that survives redeploys, e.g.
#   MEDIA_ROOT=/var/lib/ldr/media
# See deployment.md §6a for the host setup commands (mkdir + chown + chmod).
MEDIA_ROOT=./media

# Comma-separated origins permitted to call the API and open WebSockets.
# Leave empty in dev (vite :5173 → api :8080 works open) — REQUIRED in
# prod, otherwise CORS is wildcard-open and the WS upgrader skips origin
# verification. Include scheme + host, no trailing slash:
#   ALLOWED_ORIGINS=https://ldr.example.com
ALLOWED_ORIGINS=

# Set to 1 only when the server runs behind a reverse proxy that strips
# and rewrites X-Forwarded-For / X-Real-IP from inbound requests
# (Cloudflare, fly.io, an ALB). On bare metal it must stay off — otherwise
# the rate limiter trusts attacker-controlled IPs and is bypassable.
TRUST_PROXY_HEADERS=
